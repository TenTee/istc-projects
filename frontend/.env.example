# Copier ce fichier en .env.local puis renseigner les valeurs.
# Les variables NEXT_PUBLIC_* sont intégrées au moment de `npm run build` :
# après toute modification, il faut reconstruire le frontend.

# Adresse publique de l'API Django (sans /api à la fin)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Clé PUBLIQUE (site key) Google reCAPTCHA v2 « Je ne suis pas un robot ».
# Laisser vide pour masquer le reCAPTCHA (développement).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
