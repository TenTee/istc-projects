# Django
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,istc.tenteeglobal.com,smart.tenteeglobal.com

# PostgreSQL on same server (production)
DATABASE_URL=postgresql://smartcampus:your_password@127.0.0.1:5432/smartcampus
DB_SSL_REQUIRE=False

# Redis (optional for Celery)
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# CORS : origines (adresses du frontend) AJOUTÉES à celles déjà autorisées dans settings.py
CORS_ALLOWED_ORIGINS=

# reCAPTCHA (vérification serveur du login et de la pré-inscription).
# Laisser vide pour désactiver la vérification (développement).
RECAPTCHA_SECRET_KEY=

# Contrôle des droits du personnel par le serveur (users/acces_personnel.py).
# Laisser True. False = désactivation temporaire en cas de blocage après une mise à jour.
CONTROLE_DROITS_PERSONNEL=True
